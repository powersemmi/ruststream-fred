[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"

[dependencies]
ruststream = { version = "0.8", features = ["macros", "json", "asyncapi", "logging"] }
# The broker feature matching the core one above: it is what fills the redis extension the
# generated AsyncAPI document carries for each channel.
ruststream-fred = { version = "0.8", features = ["asyncapi"] }
schemars = "1"
serde = { version = "1", features = ["derive"] }
